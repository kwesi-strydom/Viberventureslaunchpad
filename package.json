{
  "name": "viber-online",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Viber Online Launchpad: hybrid online + live vibecoding competition platform",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server/index.ts",
    "start": "tsx --env-file-if-exists=.env.local src/server/index.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test src/engine/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/db/migrate.ts"
  },
  "dependencies": {
    "@neon/env": "^1.4.8",
    "drizzle-orm": "^0.44.0",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@neon/config": "^1.8.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
