# Copy to .env.local (git-ignored). `neon link` writes DATABASE_URL, DATABASE_URL_UNPOOLED, NEON_BRANCH for you.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
PORT=5001

# GitHub login (create an OAuth App: callback http://localhost:5001/api/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public URL of this app (no trailing slash). Use your real https URL in production.
APP_URL=http://localhost:5001
# Comma-separated GitHub handles that become admins on login
ADMIN_GITHUB_HANDLES=
# Reject GitHub accounts younger than this many days (0 = off)
MIN_GITHUB_ACCOUNT_AGE_DAYS=14
